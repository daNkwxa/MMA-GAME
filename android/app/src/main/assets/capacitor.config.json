{
	"appId": "com.mmagoat.app",
	"appName": "MMA GOAT",
	"webDir": "www",
	"ios": {
		"contentInset": "automatic",
		"allowsLinkPreview": false,
		"scrollEnabled": false
	},
	"plugins": {
		"StatusBar": {
			"overlaysWebView": true,
			"style": "DARK",
			"backgroundColor": "#0a0c10"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 2000,
			"backgroundColor": "#0a0c10",
			"showSpinner": false
		}
	},
	"server": {
		"iosScheme": "capacitor",
		"allowNavigation": []
	}
}
